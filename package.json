{
  "name": "x-mas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-prisma.mjs && npx prisma generate && next dev",
    "build": "node scripts/prepare-prisma.mjs && npx prisma generate && next build",
    "vercel-build": "node scripts/prepare-prisma.mjs && npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsc -p tsconfig.test.json && node --test .test-dist/lib/__tests__/*.test.js",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "postinstall": "node scripts/prepare-prisma.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.71.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
